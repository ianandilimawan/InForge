<?php

namespace App\Livewire\Tables;

use {{NAMESPACE}}\{{MODEL_NAME}};
use App\Services\ActivityLogService;
use Illuminate\Database\Eloquent\Builder;
use PowerComponents\LivewirePowerGrid\Facades\PowerGrid;
use PowerComponents\LivewirePowerGrid\Facades\Filter;
use PowerComponents\LivewirePowerGrid\PowerGridComponent;
use PowerComponents\LivewirePowerGrid\PowerGridFields;
use PowerComponents\LivewirePowerGrid\Column;
use PowerComponents\LivewirePowerGrid\Components\SetUp\Exportable;
use Illuminate\Support\Facades\Schema;

class {{MODEL_NAME}}Table extends PowerGridComponent
{
    public string $tableName = '{{MODEL_NAME_CAMEL}}-table';
    public string $sortField = 'id';
    public string $sortDirection = 'asc';

    public function setUp(): array
    {
        if (auth()->user() && auth()->user()->hasPermission('delete-{{MODEL_NAME_SNAKE_PLURAL}}')) {
            $this->showCheckBox();
        }

        return [
            PowerGrid::header()
                ->showSearchInput()
                ->showToggleColumns()
                ->includeViewOnTop('components.admin.bulk-action-button'),
            PowerGrid::footer()
                ->showPerPage(10, [10, 25, 50, 100])
                ->showRecordCount(),
        ];
    }

    public function datasource(): Builder
    {
        $query = {{MODEL_NAME}}::query();

        if (Schema::hasColumn('{{TABLE_NAME}}', 'sort')) {
            $query->orderBy('sort', 'asc');
        }

        return $query;
    }

    public function fields(): PowerGridFields
    {
        return PowerGrid::fields()
            ->add('id')
{{POWERGRID_FIELDS}}
            ->add('action', function ({{MODEL_NAME}} $row) {
                $canView = auth()->user() && auth()->user()->hasPermission('view-{{MODEL_NAME_SNAKE_PLURAL}}');
                $canEdit = auth()->user() && auth()->user()->hasPermission('edit-{{MODEL_NAME_SNAKE_PLURAL}}');
                $canDelete = auth()->user() && auth()->user()->hasPermission('delete-{{MODEL_NAME_SNAKE_PLURAL}}');

                if (!$canView && !$canEdit && !$canDelete) {
                    return '<span class="text-zinc-400 dark:text-zinc-500 text-xs">-</span>';
                }

                return view('components.table-actions', [
                    'viewUrl' => $canView ? route('{{ROUTE_NAME}}.show', $row->id) : null,
                    'editUrl' => $canEdit ? route('{{ROUTE_NAME}}.edit', $row->id) : null,
                    'deleteUrl' => $canDelete ? route('{{ROUTE_NAME}}.destroy', $row->id) : null,
                ])->render();
            });
    }

    public function columns(): array
    {
        return [
            Column::add()->title('No')->index()
                ->headerAttribute('text-center')
                ->bodyAttribute('text-center'),

{{POWERGRID_COLUMNS}}
            Column::make('Actions', 'action')
                ->headerAttribute('text-right')
                ->bodyAttribute('text-right')
                ->visibleInExport(false),
        ];
    }

    public function filters(): array
    {
        return [
{{POWERGRID_FILTERS}}
        ];
    }

    #[\Livewire\Attributes\On('triggerBulkDelete')]
    public function triggerBulkDelete(?array $ids = null): void
    {
        if (!$ids) {
            $ids = $this->checkboxValues;
        }

        if (empty($ids)) return;

        // Ensure user has permission
        // if (!auth()->user()->hasPermission('delete-{{modelName}}')) {
        //     $this->dispatch('notify', type: 'error', message: 'You do not have permission to delete {{modelName}}s.');
        //     return;
        // }

        $this->dispatch('confirm-bulk-delete', [
            'ids' => $ids,
            'model' => 'App\\\\Models\\\\{{MODEL_NAME}}',
            'refreshRoute' => 'refreshDatatable'
        ]);
    }

    #[\Livewire\Attributes\On('bulkDeleteConfirmed')]
    public function bulkDeleteConfirmed($ids, $model): void
    {
        // TODO: Ensure user has permission
        // if (!auth()->user()->hasPermission('delete-{{modelName}}')) return;

        try {
            {{MODEL_NAME}}::whereIn('id', $ids)->delete();
            ActivityLogService::logBulkDelete({{MODEL_NAME}}::class, count($ids), $ids);

            $this->js('window.pgBulkActions.clearAll()');
            $this->dispatch('notify', type: 'success', message: count($ids) . ' {{modelName}}s have been deleted.');
        } catch (\Exception $e) {
            $this->dispatch('notify', type: 'error', message: 'Failed to delete {{modelName}}s.');
        }
    }
}
